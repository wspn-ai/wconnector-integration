# ─── Identity (required) ──────────────────────────────────────────────
# Bearer credential from W Connector application approval.
CONNECTOR_API_KEY=sk_replace_me_after_approval

# W Connector URL.
#   dev:  https://connector-dev.wcheckout.app   ← use this for testing
#   prod: https://connector.wcheckout.app
GATEWAY_URL=https://connector-dev.wcheckout.app

# ─── Runtime (required) ───────────────────────────────────────────────
SHOP_PORT=8001
PRODUCTS_FILE=products/catalog.json

# ─── Stablelink (required for accepting payments) ─────────────────────
# Three values from your Stablelink merchant dashboard at https://stablelink.app
# Integration docs: https://developer.wcheckout.app/7441280m0
# WCHECKOUT_SIGN_KEY is the HMAC-SHA512 webhook signing key — NOT the
# same as WCHECKOUT_API_SECRET.
WCHECKOUT_API_KEY=
WCHECKOUT_API_SECRET=
WCHECKOUT_SIGN_KEY=
WCHECKOUT_SANDBOX=true        # set to false in production

# ─── Optional overrides (everything else hydrates from /merchants/me) ─
# Only set these to FORCE a value different from what W Connector has.
# In normal operation leave them blank — edit them via the W Connector
# admin dashboard instead, and your shop will pick up the new value on
# next restart.
# MERCHANT_NAME=
# MERCHANT_DESCRIPTION=
# MERCHANT_TAGS=
# MERCHANT_AGENT_URL=
